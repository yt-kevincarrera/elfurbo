{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sin --env (wrangler dev, tests): nada que ver con el Worker de producción.
  "name": "furbo-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local", "MIN_SUPPORTED_BUILD": "0" },
  // Cada hora (a su hora hace la purga diaria).
  "triggers": { "crons": ["0 * * * *"] },
  // Base local para `wrangler dev` y los tests. Los entornos remotos van en "env".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "furbo-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    // Lo que usa la app publicada. Desplegar a mano: npm run deploy:production.
    "production": {
      "name": "furbo-api",
      "vars": { "ENVIRONMENT": "production", "MIN_SUPPORTED_BUILD": "0" },
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "furbo-prod",
          "database_id": "a28607c5-8183-4dda-895e-7a35e60e4aa1",
          "migrations_dir": "migrations"
        }
      ]
    },
    "staging": {
      "name": "furbo-api-staging",
      "vars": { "ENVIRONMENT": "staging", "MIN_SUPPORTED_BUILD": "0" },
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "furbo-staging",
          "database_id": "7341098c-74f8-466f-baa7-db2ae83e9a28",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
