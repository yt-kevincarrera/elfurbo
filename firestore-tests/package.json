{
  "name": "elfurbo-firestore-rules-tests",
  "private": true,
  "description": "Tests de las reglas de seguridad de Firestore con el emulador",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-elfurbo \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.30.0"
  }
}
