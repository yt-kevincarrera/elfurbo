rules_version = '2';

// Reglas de seguridad de El Furbo.
//
// Colecciones (todas de primer nivel):
//   users/{uid}                    perfil, rol (admin|player) y estado (pending|active|blocked)
//   config/app                     configuración global
//   seasons/{id}                   temporadas (isActive, isClosed)
//   matches/{id}                   jornadas (status, date, durationMinutes, seasonId)
//   attendance/{matchId_uid}       asistencia de un jugador a una jornada (yes|no|maybe)
//   reports/{matchId_uid}          goles/asistencias reportados por un jugador en una jornada
//   mvpVotes/{matchId_voterUid}    voto de MVP de un jugador en una jornada
//
// Cierre: una jornada deja de aceptar cambios de jugadores cuando está
// cancelada, cerrada por el admin, pasaron 72 h desde su inicio (salvo que
// el admin la haya reabierto) o su temporada está cerrada. El admin puede
// escribir siempre (la app lo frena salvo que reabra).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myDoc() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && myDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActive() && myDoc().data.role == 'admin';
    }

    // El usuario tiene presencia real confirmada en la jornada (played == true).
    function isPresent(matchId, uid) {
      return exists(/databases/$(db)/documents/attendance/$(matchId + '_' + uid))
        && get(/databases/$(db)/documents/attendance/$(matchId + '_' + uid)).data.get('played', false) == true;
    }

    // Escritura propia de asistencia: la intención (status) solo antes de
    // jugarse; la presencia (played) solo después, firmada por el propio uid.
    function validOwnAttendance(d) {
      return d.get('status', 'maybe') in ['yes', 'no', 'maybe']
        && (
          (d.get('played', null) == null && !matchPlayed(d.matchId))
          || (d.get('played', null) is bool && matchPlayed(d.matchId)
              && d.get('playedSetBy', '') == request.auth.uid)
        );
    }

    function matchData(matchId) {
      return get(/databases/$(db)/documents/matches/$(matchId)).data;
    }

    function seasonClosed(seasonId) {
      return seasonId != ''
        && exists(/databases/$(db)/documents/seasons/$(seasonId))
        && get(/databases/$(db)/documents/seasons/$(seasonId)).data.get('isClosed', false) == true;
    }

    // Jornada abierta a cambios de jugadores (ver comentario de cabecera).
    function matchOpen(matchId) {
      let m = matchData(matchId);
      return m.status != 'cancelled'
        && m.status != 'closed'
        && (m.status == 'reopened' || request.time < m.date + duration.value(72, 'h'))
        && !seasonClosed(m.seasonId);
    }

    // La jornada ya terminó (hora + duración): se pueden cargar goles y votar.
    function matchPlayed(matchId) {
      let m = matchData(matchId);
      return request.time >= m.date + duration.value(m.get('durationMinutes', 120), 'm');
    }

    function validMatch(d) {
      return d.status in ['scheduled', 'cancelled', 'closed', 'reopened']
        && d.date is timestamp
        && d.get('durationMinutes', 120) is int
        && d.get('durationMinutes', 120) >= 30
        && d.get('durationMinutes', 120) <= 600;
    }

    function validReportNumbers(d) {
      return d.goals is int && d.goals >= 0 && d.goals <= 30
        && d.assists is int && d.assists >= 0 && d.assists <= 30;
    }

    // Un reporte recién creado o editado por su autor vuelve a "pendiente".
    function freshStatus(d) {
      return d.confirmations is list && d.confirmations.size() == 0
        && d.get('adminStatus', null) == null;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);

      // Alta propia: siempre como jugador pendiente. El admin (o la Cloud Function
      // para el primer usuario) lo activa después.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'player'
        && request.resource.data.status == 'pending';

      // Edición propia: solo campos de perfil, nunca rol ni estado.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'nickname', 'fcmToken', 'fcmTokens', 'updatedAt']);

      // Eliminar la propia cuenta.
      allow delete: if signedIn() && request.auth.uid == uid;

      allow update, delete: if isAdmin();
    }

    match /seasons/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /matches/{id} {
      allow read: if isActive();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && validMatch(request.resource.data);
      allow update: if isAdmin() && validMatch(request.resource.data);
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isActive();
      allow create, update: if isActive()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.matchId + '_' + request.auth.uid
        && validOwnAttendance(request.resource.data)
        && matchOpen(request.resource.data.matchId);
      allow delete: if isActive()
        && resource.data.uid == request.auth.uid
        && matchOpen(resource.data.matchId);
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isActive();

      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.matchId + '_' + request.auth.uid
        && validReportNumbers(request.resource.data)
        && freshStatus(request.resource.data)
        && matchOpen(request.resource.data.matchId)
        && matchPlayed(request.resource.data.matchId);

      // El autor edita su reporte: se resetean las confirmaciones. Un reporte
      // rechazado por el admin no se puede editar ni borrar (rechazo definitivo).
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && resource.data.get('adminStatus', null) != 'rejected'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.matchId == resource.data.matchId
        && validReportNumbers(request.resource.data)
        && freshStatus(request.resource.data)
        && matchOpen(resource.data.matchId);

      // Un compañero que jugó confirma: solo puede agregar su propio uid.
      allow update: if isActive()
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations'])
        && !(request.auth.uid in resource.data.confirmations)
        && request.resource.data.confirmations.size() == resource.data.confirmations.size() + 1
        && request.resource.data.confirmations.hasAll(resource.data.confirmations)
        && request.auth.uid in request.resource.data.confirmations
        && isPresent(resource.data.matchId, request.auth.uid)
        && matchOpen(resource.data.matchId);

      allow delete: if isActive()
        && resource.data.uid == request.auth.uid
        && resource.data.get('adminStatus', null) != 'rejected'
        && matchOpen(resource.data.matchId);
      allow update, delete: if isAdmin();
    }

    match /mvpVotes/{id} {
      allow read: if isActive();
      allow create, update: if isActive()
        && request.resource.data.voterUid == request.auth.uid
        && id == request.resource.data.matchId + '_' + request.auth.uid
        && request.resource.data.votedFor != request.auth.uid
        && isPresent(request.resource.data.matchId, request.auth.uid)
        && isPresent(request.resource.data.matchId, request.resource.data.votedFor)
        && matchOpen(request.resource.data.matchId)
        && matchPlayed(request.resource.data.matchId);
      allow delete: if isActive()
        && resource.data.voterUid == request.auth.uid
        && matchOpen(resource.data.matchId);
      allow write: if isAdmin();
    }
  }
}
